rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacherOrAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'TEACHER_ADMIN' || request.auth.token.role == 'SUPER_ADMIN');
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.role is string && (data.role == 'STUDENT' || data.role == 'TEACHER_ADMIN' || data.role == 'SUPER_ADMIN') &&
             data.level is string &&
             data.language is string &&
             data.termsAccepted is bool && data.termsAccepted == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacherOrAdmin();
      allow create: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.role == 'STUDENT';
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       // Clients cannot self-escalate role
                       request.resource.data.role == resource.data.role;
      allow delete: if isOwner(userId);
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }

    match /doubts/{doubtId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0;
      allow update: if isAuthenticated() &&
                       (request.resource.data.studentId == request.auth.uid || isTeacherOrAdmin());
      allow delete: if isAuthenticated() &&
                       (resource.data.studentId == request.auth.uid || isTeacherOrAdmin());

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                         request.resource.data.authorId == request.auth.uid &&
                         request.resource.data.content is string;
        allow update, delete: if isAuthenticated() &&
                                 (resource.data.authorId == request.auth.uid || isTeacherOrAdmin());
      }
    }
  }
}
